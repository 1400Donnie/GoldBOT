# Copy this file to .env and fill it in. .env is ignored by git, so your keys stay on your computer.
# Not needed for the alert scanner, which only reads public data.

# Use the demo site (fake money) while testing:
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=/full/path/to/your-kalshi-private-key.pem
